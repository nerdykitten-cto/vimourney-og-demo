{
  "name": "keyboard-mastery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "vim",
    "app",
    "game"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "test": "vitest run",
    "check": "npm run check -w app",
    "zip": "npm run build && node scripts/zip.mjs",
    "game": "npm run dev -w game",
    "game:build": "npm run build -w game",
    "demo:build": "npm run build -w @kbm/game && rm -rf demo/public && cp -r game/dist demo/public"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
